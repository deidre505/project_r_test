-- steam/steam.lua
-- Steam 추상화 레이어(유지보수용)
-- 지금은 sworks(FFI 기반 Steamworks)를 사용한다.
-- 나중에 서버/다른 바인딩으로 바꿔도, 다른 파일은 최대한 안 건드리게 만드는 게 목표.

local M = {}

M.available = false
M.inited = false
M.lastError = nil

local steam = nil

function M.init()
  if M.inited then return true end

  -- 1) sworks 로드 시도
  local ok, mod = pcall(require, "sworks")
  if not ok or not mod then
    M.available = false
    M.inited = false
    M.lastError = "sworks not found. (Did you add /sworks folder correctly?)"
    return false
  end

  steam = mod
  M.available = true

  -- 2) Steam 초기화
  local ok2, err = pcall(function()
    steam.init()
  end)

  if not ok2 then
    M.inited = false
    M.lastError = tostring(err)
    return false
  end

  M.inited = true
  M.lastError = nil
  return true
end

function M.update()
  -- Steam 콜백 처리(매 프레임)
  if not M.inited or not steam then return end
  -- sworks는 update()로 콜백을 처리한다고 안내 :contentReference[oaicite:5]{index=5}
  pcall(steam.update)
end

function M.shutdown()
  -- sworks는 명시적인 shutdown이 없을 수 있으니 안전하게 비워둠
  M.inited = false
end

function M.getStatus()
  if not M.available then
    return false, "Steam: NOT AVAILABLE (" .. (M.lastError or "binding not installed") .. ")"
  end
  if not M.inited then
    return false, "Steam: INIT FAILED (" .. (M.lastError or "unknown") .. ")"
  end
  return true, "Steam: OK (sworks)"
end

-- (다음 단계용 자리) 친구초대/로비/P2P는 여기서 확장
M._raw = function() return steam end

return M
